[importlinter]
root_packages =
    api
    application
    ingestion

[importlinter:contract:no_application_to_api]
name = Forbid application depending on api
type = forbidden
source_modules =
    application
forbidden_modules =
    api

[importlinter:contract:no_ingestion_to_api]
name = Forbid ingestion depending on api
type = forbidden
source_modules =
    ingestion
forbidden_modules =
    api

[importlinter:contract:no_ingestion_to_application]
name = Forbid ingestion depending on application
type = forbidden
source_modules =
    ingestion
forbidden_modules =
    application

[importlinter:contract:no_exchange_adapters_to_application]
name = Forbid exchange adapters depending on application services
type = forbidden
source_modules =
    ingestion.exchanges
forbidden_modules =
    application
